#!/bin/sh
# Generated by regied. Do not edit: every apply rewrites this file.
#
# pppd runs this when a session comes up. It puts the address the session was
# given into the nftables set the hairpin rules match on.
# The set is named after the interface pppd passes in, so one script serves every
# session.
#
# It never fails. A line that comes up before regied has installed its table has
# nothing to write to yet, and the apply that installs it seeds the set itself.

interface="$1"
address="$4"

[ -n "$interface" ] || exit 0
[ -n "$address" ] || exit 0

nft add element inet regied "uplink4_${interface}" "{ ${address} }" >/dev/null 2>&1
exit 0
