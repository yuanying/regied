#!/bin/sh
# Generated by regied. Do not edit: every apply rewrites this file.
#
# pppd runs this when a session goes down. It takes the address the session had
# out of the nftables set the hairpin rules match on.
# The set is named after the interface pppd passes in, so one script serves every
# session.
#
# It never fails. With no table there is nothing to take the address out of, and
# the next apply seeds the set from the links as they are then.

interface="$1"
address="$4"

[ -n "$interface" ] || exit 0
[ -n "$address" ] || exit 0

nft delete element inet regied "uplink4_${interface}" "{ ${address} }" >/dev/null 2>&1
exit 0
